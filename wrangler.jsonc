{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "background-removal",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "containers": [
    {
      "class_name": "BackgroundRemovalContainer",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "BackgroundRemovalContainer",
        "name": "BACKGROUND_REMOVAL"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BackgroundRemovalContainer"]
    }
  ]
}
